# Local data, private documents, and unrelated working files
/data/*
/初始/
/Rz/
/PINOPROP.zip
/修订.pdf
/pelican-bike.html

# Unpublished manuscripts, rendered figures, and editorial records stay local.
# Retain the Python plotting utilities required by the public experiment scripts.
/paper/*
!/paper/figure_code/
/paper/figure_code/*
!/paper/figure_code/*.py
/paper_ch/
/paper-v1/

# Local configuration and credentials; retain a shareable environment template.
/.claude/
/.vscode/
.idea/
*.code-workspace
.env
.env.*
!.env.example
*.pem
*.key

# Experiment outputs: publish only the result/equation JSONs.
# Reopen each selected directory, then allow only its direct JSON children.
# Models, run histories, backups, and layout checks remain local.
/outputs/*
!/outputs/aggregate/
/outputs/aggregate/*
!/outputs/aggregate/*.json
!/outputs/spider/
/outputs/spider/*
!/outputs/spider/*.json

# Large ML/data artifacts and logs, wherever generated
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.h5
*.hdf5
*.zarr/
*.log

# Publish only the original HIT frames and their dataset/trajectory metadata.
# Keep derived caches and other large artifacts excluded.
!/data/generated_hit_ns/
/data/generated_hit_ns/*
!/data/generated_hit_ns/manifest.json
!/data/generated_hit_ns/trajectory_[0-9][0-9][0-9]/
/data/generated_hit_ns/trajectory_[0-9][0-9][0-9]/*
!/data/generated_hit_ns/trajectory_[0-9][0-9][0-9]/metadata.json
!/data/generated_hit_ns/trajectory_[0-9][0-9][0-9]/frame_[0-9][0-9][0-9].npz

# Python environments, caches, packaging, and test reports
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# LaTeX intermediates for local manuscript compilation
*.aux
*.bbl
*.blg
*.bcf
*.fdb_latexmk
*.fls
*.lof
*.lot
*.loa
*.lol
*.out
*.spl
*.synctex.gz
*.synctex(busy)
*.toc
*.run.xml
*.xdv
*.dvi
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
/paper/out/
/paper_ch/out/
/paper/figures/*_preview.png
/paper_ch/figures/*_preview.png

# Editor backups and operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
